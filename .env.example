# Copie este arquivo para .env e ajuste os valores antes de rodar com docker-compose
POSTGRES_PASSWORD=troque_esta_senha

# Gere um valor forte com: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=troque_esta_chave_tambem

# Deixe "false" para acesso local por HTTP. Mude para "true" só quando a
# aplicação estiver atrás de HTTPS de verdade (ex: Cloudflare Tunnel) —
# senão o cookie de sessão não funciona e o login falha.
SESSION_COOKIE_SECURE=false
